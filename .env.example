# ===== App =====
APP_ENV=development
APP_LOG_LEVEL=info

# ===== LLM (OpenAI-compatible endpoints: DeepSeek / Qwen / GLM) =====
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ===== Embedding / Rerank (M1) =====
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=
RERANK_PROVIDER=
RERANK_API_KEY=

# ===== Database (prod profile; demo uses SQLite/in-memory) =====
DATABASE_URL=postgresql://rfq:rfq@localhost:5432/rfq

# ===== Observability (optional) =====
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
