# ===== App =====
APP_ENV=development
APP_LOG_LEVEL=info

# ===== LLM (OpenAI-compatible endpoints: DeepSeek / Qwen / GLM) =====
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ===== Embedding / Rerank (M1) =====
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=
RERANK_PROVIDER=
RERANK_API_KEY=

# ===== Adapter / 站点内部 API（vacuum_b2b_sample 真通道；demo 可留空）=====
# demo（内置演示数据）| vacuum_b2b_sample（站点内部 API 真通道）
ADAPTER=demo
INTERNAL_API_BASE_URL=
INTERNAL_API_TOKEN=
# E1 鉴权桥：与宿主站点 .env 的 AI_TICKET_SECRET 同值；空=不验签（本地开发向后兼容）
AI_TICKET_SECRET=
# 游客分层门（true：游客限 0-token 路径，LLM 轮次返回 login_required）
GUEST_TIER_ENABLED=false

# ===== 知识数据（08-knowledge-export-spec）=====
# 站点导出的离线知识目录（knowledge.json + export_manifest.json）；空 = 内置 demo 数据
KNOWLEDGE_DATA_DIR=
# RAG 向量存储：inmemory（demo/CI）| pgvector（prod，HNSW）
RAG_STORE=inmemory
RAG_PGVECTOR_DSN=
# 语料保鲜阈值（天）
RAG_STALE_DAYS=14
# 引擎内置每日兜底刷新（webhook 防丢失的定时兜底；显式 opt-in）
KNOWLEDGE_REFRESH_ENABLED=false
KNOWLEDGE_SOURCE_DIR=
KNOWLEDGE_REFRESH_INTERVAL_HOURS=24

# ===== 运营观测数据落盘（spec 02-engine-read-api-spec）=====
# feedback / no_match_events / hit_stats 的 JSONL 落盘目录；空 = 纯内存（重启丢）
RUNTIME_DATA_DIR=runtime_data

# ===== Checkpointer（会话状态持久化）=====
# memory（默认，重启丢）| sqlite（单机持久）| postgres（多实例）
CHECKPOINTER_BACKEND=memory
CHECKPOINTER_SQLITE_PATH=.data/checkpoints.sqlite
CHECKPOINTER_POSTGRES_DSN=

# ===== Database (prod profile; demo uses SQLite/in-memory) =====
DATABASE_URL=postgresql://rfq:rfq@localhost:5432/rfq

# ===== Observability (optional) =====
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ===== CORS (QA-0001 / ADR-0005; REQUIRED in production) =====
# 逗号分隔的显式白名单源；未设置时仅本机开发源（localhost/127.0.0.1）放行
# CORS_ALLOW_ORIGINS=https://your-domain.com,https://www.your-domain.com
CORS_ALLOW_ORIGINS=
